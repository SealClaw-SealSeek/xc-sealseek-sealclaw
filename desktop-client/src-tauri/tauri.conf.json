{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "玺牛内测版",
  "version": "0.1.7",
  "identifier": "com.sealclaw.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "玺牛内测版",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QjEwNkRGOTA5MDZFMTIKUldRU2JwQ1Ezd2F4Wm1WZUJGZDBHaWVPRXE4dXh4d0VSc25IQm5LbUpzb1ZoNm1vMzRYbDhrK1cK",
      "endpoints": [
        "https://gitee.com/xc-sealseek-ai/sealseek-sealclaw-desktop/raw/release/latest.json"
      ],
      "dialog": false
    }
  }
}
