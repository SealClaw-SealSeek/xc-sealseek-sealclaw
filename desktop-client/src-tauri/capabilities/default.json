{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SealClaw Desktop 默认权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "process:default",
    "notification:default",
    "updater:default"
  ]
}
